// ================================================================
//  SISTEMA DE CRAFTEO
// ================================================================
class CraftingSystem {
  constructor(inventory) {
    this.inventory = inventory;
    this.grid = new Array(4).fill(null);
    this.result = null;
  }
  getRecipes() {
    return [
      { name:'Madera → Tablas', input:[{type:BLOCK.WOOD,count:1}], output:{type:BLOCK.PLANKS,count:4}, pattern:null },
      { name:'Tablas → Madera', input:[{type:BLOCK.PLANKS,count:4}], output:{type:BLOCK.WOOD,count:1}, pattern:[BLOCK.PLANKS,BLOCK.PLANKS,BLOCK.PLANKS,BLOCK.PLANKS] },
      { name:'Hojas → Tierra',  input:[{type:BLOCK.LEAVES,count:4}], output:{type:BLOCK.DIRT,count:1},  pattern:[BLOCK.LEAVES,BLOCK.LEAVES,BLOCK.LEAVES,BLOCK.LEAVES] },
    ];
  }
  updateGrid() {
    this.result = null;
    for (const recipe of this.getRecipes()) {
      if (this.matchesRecipe(recipe)) { this.result = recipe.output; break; }
    }
  }
  matchesRecipe(recipe) {
    if (!recipe.pattern) {
      const input = recipe.input[0];
      for (const slot of this.grid) {
        if (slot && slot.type === input.type && slot.count >= input.count) return true;
      }
      return false;
    }
    if (recipe.pattern) {
      for (let i = 0; i < 4; i++) {
        if (!this.grid[i] || this.grid[i].type !== recipe.pattern[i]) return false;
      }
      for (let i = 0; i < 4; i++) {
        if (this.grid[i].count < 1) return false;
      }
      return true;
    }
    return false;
  }
  craft() {
    if (!this.result) return false;
    const recipes = this.getRecipes();
    let usedRecipe = null;
    for (const recipe of recipes) {
      if (this.matchesRecipe(recipe)) { usedRecipe = recipe; break; }
    }
    if (!usedRecipe) return false;
    if (usedRecipe.pattern) {
      for (let i = 0; i < 4; i++) {
        if (this.grid[i]) {
          this.grid[i].count--;
          if (this.grid[i].count <= 0) this.grid[i] = null;
        }
      }
    } else {
      const input = usedRecipe.input[0];
      for (let i = 0; i < 4; i++) {
        if (this.grid[i] && this.grid[i].type === input.type) {
          this.grid[i].count -= input.count;
          if (this.grid[i].count <= 0) this.grid[i] = null;
          break;
        }
      }
    }
    this.inventory.addItem(this.result.type, this.result.count);
    this.updateGrid();
    return true;
  }
  placeInGrid(gridIndex, inventoryIndex) {
    if (gridIndex < 0 || gridIndex >= 4) return;
    if (inventoryIndex < 0 || inventoryIndex >= CFG.INVENTORY_SIZE) return;
    const invSlot = this.inventory.slots[inventoryIndex];
    if (!invSlot) return;
    if (this.grid[gridIndex]) {
      this.inventory.addItem(this.grid[gridIndex].type, this.grid[gridIndex].count);
    }
    this.grid[gridIndex] = { type: invSlot.type, count: 1 };
    this.inventory.removeItem(inventoryIndex, 1);
    this.updateGrid();
  }
  removeFromGrid(gridIndex) {
    if (gridIndex < 0 || gridIndex >= 4) return;
    if (!this.grid[gridIndex]) return;
    this.inventory.addItem(this.grid[gridIndex].type, this.grid[gridIndex].count);
    this.grid[gridIndex] = null;
    this.updateGrid();
  }
  clearGrid() {
    for (let i = 0; i < 4; i++) {
      if (this.grid[i]) {
        this.inventory.addItem(this.grid[i].type, this.grid[i].count);
        this.grid[i] = null;
      }
    }
    this.updateGrid();
  }
}
