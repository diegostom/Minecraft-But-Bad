  document.getElementById('fov-val').textContent = settings.fov + '°';
  applySettings();
});
document.getElementById('fog-far').addEventListener('input', (e) => {
  settings.fogFar = parseInt(e.target.value);
  document.getElementById('fog-far-val').textContent = settings.fogFar;
  applySettings();
});

document.getElementById('btn-done').addEventListener('click', () => toggleSettings());
document.getElementById('btn-reset').addEventListener('click', () => {
  Object.assign(settings, settingsDefaults);
  updateSettingsUI();
  applySettings();
});


// ================================================================
//  SISTEMA DE MINAR Y COLOCAR
// ================================================================
let isMouseDown = false;
let miningTarget = null;
let miningProgress = 0;
let lastHitSound = 0;

const highlightGeo = new THREE.BoxGeometry(1.01, 1.01, 1.01);
const highlightMat = new THREE.MeshBasicMaterial({
  color: 0x000000, wireframe: true, transparent: true, opacity: 0.5,
});
const highlightMesh = new THREE.Mesh(highlightGeo, highlightMat);
highlightMesh.visible = false;
scene.add(highlightMesh);

const miningOverlayGeo = new THREE.BoxGeometry(1.02, 1.02, 1.02);
const miningOverlayMat = new THREE.MeshBasicMaterial({
  color: 0xFF0000, transparent: true, opacity: 0.0,
});
const miningOverlayMesh = new THREE.Mesh(miningOverlayGeo, miningOverlayMat);
miningOverlayMesh.visible = false;
scene.add(miningOverlayMesh);

function getCameraDirection() {
  const dir = new THREE.Vector3(0, 0, -1);
  const euler = new THREE.Euler(player.pitch, player.yaw, 0, 'YXZ');
  dir.applyEuler(euler);
  return dir;
}

function updateMining(dt) {
  const dir = getCameraDirection();
  const hit = raycastVoxel(player.position, dir, CFG.REACH_DISTANCE);

  if (hit) {
    highlightMesh.position.set(hit.x, hit.y, hit.z);
    highlightMesh.visible = true;

    if (isMouseDown) {
      if (miningTarget && miningTarget.x === hit.x && miningTarget.y === hit.y && miningTarget.z === hit.z) {
        miningProgress += dt;
        miningOverlayMesh.position.copy(highlightMesh.position);
        miningOverlayMat.opacity = Math.min(miningProgress / CFG.MINING_TIME, 1.0) * 0.5;
        miningOverlayMesh.visible = true;

        if (miningProgress - lastHitSound > 0.15) {
          audio.playHit();
          lastHitSound = miningProgress;
        }

        if (miningProgress >= CFG.MINING_TIME) {
          mineBlock(hit.x, hit.y, hit.z);
          miningTarget = null;
          miningProgress = 0;
          miningOverlayMesh.visible = false;
        }
      } else {
        miningTarget = { x: hit.x, y: hit.y, z: hit.z };
        miningProgress = 0;
        lastHitSound = 0;
        miningOverlayMesh.visible = false;
      }
    } else {
      miningTarget = null;
      miningProgress = 0;
      miningOverlayMesh.visible = false;
    }
  } else {
    highlightMesh.visible = false;
    miningOverlayMesh.visible = false;
    miningTarget = null;
    miningProgress = 0;
  }
}

function mineBlock(x, y, z) {
  const type = world.getBlock(x, y, z);
  if (type === BLOCK.AIR || type === BLOCK.BEDROCK) return;
  inventory.addItem(type, 1);
  updateHotbarUI();
  world.setBlock(x, y, z, BLOCK.AIR);
  audio.playBreak();
}

function placeBlock() {
  const selectedItem = inventory.getSelectedItem();
  if (!selectedItem) return;
  const dir = getCameraDirection();
  const hit = raycastVoxel(player.position, dir, CFG.REACH_DISTANCE);
  if (!hit) return;

  let px = hit.x, py = hit.y, pz = hit.z;
  switch (hit.face) {
    case 'top':    py += 1; break;
    case 'bottom': py -= 1; break;
    case 'east':   px += 1; break;
    case 'west':   px -= 1; break;
    case 'north':  pz -= 1; break;
    case 'south':  pz += 1; break;
  }

  const hw = player.width / 2;
  const playerMinX = player.position.x - hw;
  const playerMaxX = player.position.x + hw;
  const playerMinY = player.position.y;
  const playerMaxY = player.position.y + player.height;
  const playerMinZ = player.position.z - hw;
  const playerMaxZ = player.position.z + hw;

  if (px + 1 > playerMinX && px < playerMaxX &&
      py + 1 > playerMinY && py < playerMaxY &&
      pz + 1 > playerMinZ && pz < playerMaxZ) {
    return;
  }

  if (world.getBlock(px, py, pz) !== BLOCK.AIR) return;

  world.setBlock(px, py, pz, selectedItem.type);
  inventory.removeItem(inventory.selectedSlot, 1);
  updateHotbarUI();
  audio.playPlace();
}

document.addEventListener('mousedown', (e) => {
  if (!isLocked || showInventory || showCrafting || showSettings) return;
  if (e.button === 0) {
    isMouseDown = true;
  } else if (e.button === 2) {
    placeBlock();
  }
});

document.addEventListener('mouseup', (e) => {
  if (e.button === 0) {
    isMouseDown = false;
    miningTarget = null;
    miningProgress = 0;
    miningOverlayMesh.visible = false;
  }
});

document.addEventListener('contextmenu', (e) => e.preventDefault());


// ================================================================
//  HUD
// ================================================================
function updateHUD() {
  const p = player.position;
  const { cx, cz } = world.getChunkCoords(p.x, p.z);
  const biomeName = world.getBiomeAt(p.x, p.z);
  const selectedItem = inventory.getSelectedItem();
  const blockName = selectedItem ? BLOCK_NAMES[selectedItem.type] : 'Ninguno';
  hud.innerHTML =
    `XYZ: ${p.x.toFixed(1)} / ${p.y.toFixed(1)} / ${p.z.toFixed(1)}<br>` +
    `Chunk: ${cx}, ${cz} | Bioma: ${biomeName}<br>` +
    `Chunks: ${world.chunks.size} | FPS: ${currentFPS}<br>` +
    `Bloque: ${blockName} (${selectedItem ? selectedItem.count : 0})`;
}


// ================================================================
//  BUCLE PRINCIPAL
// ================================================================
let lastTime = performance.now();
let currentFPS = 0;
let frameCount = 0;
let fpsTimer = 0;

createHotbarUI();
createInventoryUI();
createCraftingUI();
updateSettingsUI();
applySettings();

world.update(0, 0);

function gameLoop(now) {
  requestAnimationFrame(gameLoop);

  let dt = (now - lastTime) / 1000;
  lastTime = now;
  dt = Math.min(dt, 0.1);

  frameCount++;
  fpsTimer += dt;
  if (fpsTimer >= 1.0) {
    currentFPS = frameCount;
    frameCount = 0;
    fpsTimer -= 1.0;
  }

  if (isLocked && !showInventory && !showCrafting && !showSettings) {
    updatePlayer(dt);
    updateMining(dt);
  }

  world.update(player.position.x, player.position.z);
  updateHUD();
  renderer.render(scene, camera);
}

requestAnimationFrame(gameLoop);

</script>
