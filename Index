<script>
// ================================================================
//  CONFIGURACIÓN DEL MUNDO
// ================================================================
const CFG = {
  CHUNK_SIZE   : 16,
  MAX_Y        : 64,
  RENDER_DIST  : 5,
  SEA_LEVEL    : 18,
  NOISE_SCALE  : 4.0,
  OCTAVES      : 5,
  PERSISTENCE  : 0.48,
  LACUNARITY   : 2.1,
  SEED         : 42,
  BIOME_SCALE  : 2.0,
