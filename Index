function checkCollision(px, py, pz) {
  const hw = player.width / 2;
  const minX = Math.floor(px - hw);
  const maxX = Math.floor(px + hw - 0.001);
  const minY = Math.floor(py);
  const maxY = Math.floor(py + player.height - 0.001);
  const minZ = Math.floor(pz - hw);
  const maxZ = Math.floor(pz + hw - 0.001);

  for (let x = minX; x <= maxX; x++) {
    for (let y = minY; y <= maxY; y++) {
      for (let z = minZ; z <= maxZ; z++) {
        const block = world.getBlock(x, y, z);
        if (block !== BLOCK.AIR && block !== BLOCK.WATER && block !== BLOCK.LEAVES) {
          return true;
        }
      }
    }
  }
  return false;
}

function updatePlayer(dt) {
  const forward = new THREE.Vector3(-Math.sin(player.yaw), 0, -Math.cos(player.yaw));
  const right   = new THREE.Vector3( Math.cos(player.yaw), 0, -Math.sin(player.yaw));

  const moveDir = new THREE.Vector3(0, 0, 0);
  if (keys.w) moveDir.add(forward);
  if (keys.s) moveDir.sub(forward);
  if (keys.d) moveDir.add(right);
  if (keys.a) moveDir.sub(right);

  const isMoving = moveDir.lengthSq() > 0;
  if (isMoving) moveDir.normalize();

  player.velocity.x = moveDir.x * CFG.MOVE_SPEED;
  player.velocity.z = moveDir.z * CFG.MOVE_SPEED;
  player.velocity.y -= CFG.GRAVITY * dt;

  if (keys.space && player.onGround) {
    player.velocity.y = CFG.JUMP_FORCE;
    player.onGround = false;
    audio.playJump();
  }

  const newX = player.position.x + player.velocity.x * dt;
  if (!checkCollision(newX, player.position.y, player.position.z)) {
    player.position.x = newX;
  } else {
    player.velocity.x = 0;
  }

  const newZ = player.position.z + player.velocity.z * dt;
  if (!checkCollision(player.position.x, player.position.y, newZ)) {
    player.position.z = newZ;
  } else {
    player.velocity.z = 0;
  }

  const newY = player.position.y + player.velocity.y * dt;
  if (!checkCollision(player.position.x, newY, player.position.z)) {
    player.position.y = newY;
    player.onGround = false;
  } else {
    if (player.velocity.y < 0) player.onGround = true;
    player.velocity.y = 0;
  }

  if (player.position.y < -20) {
    const startH = world.getGroundY(0, 0);
    player.position.set(0, startH + CFG.PLAYER_HEIGHT + 2, 0);
    player.velocity.set(0, 0, 0);
  }

  if (isMoving && player.onGround) {
    player.stepTimer += dt;
    if (player.stepTimer >= CFG.STEP_INTERVAL) {
      player.stepTimer = 0;
      audio.playStep();
    }
  } else {
    player.stepTimer = 0;
  }

  camera.position.set(
    player.position.x,
    player.position.y + CFG.EYE_HEIGHT,
    player.position.z
  );
  camera.rotation.order = 'YXZ';
  camera.rotation.y = player.yaw;
  camera.rotation.x = player.pitch;
}


