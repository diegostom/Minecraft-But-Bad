        ctx.fillRect(x, y, 1, 1);
      }
    }
  }
}


// ================================================================
//  GENERADOR DE RUIDO PERLIN 2D
// ================================================================
class PerlinNoise {
  constructor(seed) {
    this.perm = new Uint8Array(512);
    const p = new Uint8Array(256);
    for (let i = 0; i < 256; i++) p[i] = i;
    let s = seed | 0;
    for (let i = 255; i > 0; i--) {
      s = (s * 16807 + 0) % 2147483647;
      const j = s % (i + 1);
      const tmp = p[i]; p[i] = p[j]; p[j] = tmp;
    }
    for (let i = 0; i < 512; i++) this.perm[i] = p[i & 255];
  }
  fade(t) { return t * t * t * (t * (t * 6 - 15) + 10); }
  lerp(a, b, t) { return a + t * (b - a); }
  grad(hash, x, y) {
    const h = hash & 3;
    const u = h < 2 ? x : y;
    const v = h < 2 ? y : x;
    return ((h & 1) ? -u : u) + ((h & 2) ? -v : v);
  }
  noise2D(x, y) {
    const X = Math.floor(x) & 255;
    const Y = Math.floor(y) & 255;
    x -= Math.floor(x);
    y -= Math.floor(y);
    const u = this.fade(x);
    const v = this.fade(y);
    const A = this.perm[X] + Y;
    const B = this.perm[X + 1] + Y;
    return this.lerp(
      this.lerp(this.grad(this.perm[A], x, y), this.grad(this.perm[B], x-1, y), u),
      this.lerp(this.grad(this.perm[A+1], x, y-1), this.grad(this.perm[B+1], x-1, y-1), u),
      v
    );
  }
  fbm(x, y, octaves, persistence, lacunarity) {
    let value = 0, amplitude = 1, frequency = 1, maxVal = 0;
    for (let i = 0; i < octaves; i++) {
      value += this.noise2D(x * frequency, y * frequency) * amplitude;
      maxVal += amplitude;
      amplitude *= persistence;
      frequency *= lacunarity;
    }
    return value / maxVal;
  }
}

const noise = new PerlinNoise(CFG.SEED);
const biomeNoise = new PerlinNoise(CFG.SEED + 1);
const treeNoise = new PerlinNoise(CFG.SEED + 2);


// ================================================================
//  SISTEMA DE BIOMAS
// ================================================================
function getBiome(wx, wz) {
  const nx = wx / 200 * CFG.BIOME_SCALE;
  const nz = wz / 200 * CFG.BIOME_SCALE;
  const continentality = biomeNoise.fbm(nx, nz, 3, 0.5, 2.0);
  const moisture = biomeNoise.fbm(nx + 100, nz + 100, 3, 0.5, 2.0);
  const rockiness = biomeNoise.fbm(nx + 200, nz + 200, 2, 0.5, 2.0);
  const c = (continentality + 1) * 0.5;
  const r = (rockiness + 1) * 0.5;
  if (r > 0.75 && c > 0.5) return BIOME.ROCK;
  if (c < 0.35) return BIOME.OCEAN;
  if (c < 0.42) return BIOME.BEACH;
  if (c < 0.55) return BIOME.PLAINS;
  if (c < 0.70) return BIOME.HILLS;
  return BIOME.MOUNTAINS;
}


// ================================================================
//  GENERACIÓN DE ÁRBOLES
// ================================================================
function generateTree(chunk, lx, lz, groundY) {
  const CS = chunk.CS;
  const MAX_Y = chunk.MAX_Y;
  const trunkHeight = 4 + Math.floor(Math.random() * 3);
  for (let y = 1; y <= trunkHeight; y++) {
    if (groundY + y < MAX_Y) chunk.setBlock(lx, groundY + y, lz, BLOCK.WOOD);
  }
  const leafStart = groundY + trunkHeight - 2;
  const leafEnd = groundY + trunkHeight + 1;
  const leafRadius = 2;
  for (let dy = leafStart; dy <= leafEnd; dy++) {
    for (let dx = -leafRadius; dx <= leafRadius; dx++) {
      for (let dz = -leafRadius; dz <= leafRadius; dz++) {
        const dist = Math.sqrt(dx * dx + dz * dz);
        if (dist <= leafRadius + 0.5) {
          const treeX = lx + dx;
          const treeZ = lz + dz;
          if (treeX >= 0 && treeX < CS && treeZ >= 0 && treeZ < CS && dy < MAX_Y) {
            if (chunk.getBlock(treeX, dy, treeZ) === BLOCK.AIR) {
              chunk.setBlock(treeX, dy, treeZ, BLOCK.LEAVES);
            }
          }
        }
      }
    }
  }
}


// ================================================================
//  CLASE CHUNK
// ================================================================
class Chunk {
  constructor(cx, cz, world) {
    this.cx = cx; this.cz = cz; this.world = world;
    this.CS = CFG.CHUNK_SIZE; this.MAX_Y = CFG.MAX_Y;
    this.blocks = new Uint8Array(this.CS * this.CS * this.MAX_Y);
    this.meshes = {}; this.dirty = true;
  }
  idx(x, y, z) { return x + z * this.CS + y * this.CS * this.CS; }
  getBlock(x, y, z) {
    if (x < 0 || x >= this.CS || z < 0 || z >= this.CS || y < 0 || y >= this.MAX_Y) return BLOCK.AIR;
    return this.blocks[this.idx(x, y, z)];
  }
  setBlock(x, y, z, type) {
    if (x < 0 || x >= this.CS || z < 0 || z >= this.CS || y < 0 || y >= this.MAX_Y) return;
    this.blocks[this.idx(x, y, z)] = type;
    this.dirty = true;
  }
  generate() {
    const CS = this.CS;
    const worldX = this.cx * CS;
    const worldZ = this.cz * CS;
    for (let lx = 0; lx < CS; lx++) {
      for (let lz = 0; lz < CS; lz++) {
        const wx = worldX + lx;
        const wz = worldZ + lz;
        const biome = getBiome(wx, wz);
        const params = BIOME_PARAMS[biome];
        const nx = wx / 100 * CFG.NOISE_SCALE * params.scale;
        const nz = wz / 100 * CFG.NOISE_SCALE * params.scale;
        const n = noise.fbm(nx, nz, CFG.OCTAVES, CFG.PERSISTENCE, CFG.LACUNARITY);
        const height = Math.floor(params.minH + (n + 1) * 0.5 * (params.maxH - params.minH));
        const clampedHeight = Math.max(1, Math.min(this.MAX_Y - 2, height));
        for (let y = 0; y <= clampedHeight; y++) {
          let type;
          if (y === 0) type = BLOCK.BEDROCK;
          else if (y === clampedHeight) {
            if (biome === BIOME.BEACH || clampedHeight <= CFG.SEA_LEVEL) type = BLOCK.SAND;
            else if (biome === BIOME.ROCK) type = BLOCK.STONE;
            else type = BLOCK.GRASS;
          } else if (y > clampedHeight - 4) type = BLOCK.DIRT;
          else type = BLOCK.STONE;
          this.blocks[this.idx(lx, y, lz)] = type;
        }
        if (clampedHeight < CFG.SEA_LEVEL) {
          for (let y = clampedHeight + 1; y <= CFG.SEA_LEVEL; y++) {
            this.blocks[this.idx(lx, y, lz)] = BLOCK.WATER;
          }
        }
      }
    }
    for (let lx = 2; lx < CS - 2; lx++) {
      for (let lz = 2; lz < CS - 2; lz++) {
        const wx = worldX + lx;
        const wz = worldZ + lz;
        const biome = getBiome(wx, wz);
        const params = BIOME_PARAMS[biome];
        if (!params.trees) continue;
        const treeNoiseVal = treeNoise.noise2D(wx * 0.1, wz * 0.1);
        const shouldPlaceTree = treeNoiseVal > (1 - CFG.TREE_DENSITY * 10);
        if (shouldPlaceTree) {
          let groundY = -1;
          for (let y = this.MAX_Y - 1; y >= 0; y--) {
            if (this.blocks[this.idx(lx, y, lz)] !== BLOCK.AIR && 
                this.blocks[this.idx(lx, y, lz)] !== BLOCK.WATER) {
              groundY = y; break;
            }
          }
          if (groundY > 0 && groundY < this.MAX_Y - 8) {
            if (this.blocks[this.idx(lx, groundY, lz)] === BLOCK.GRASS) {
              generateTree(this, lx, lz, groundY);
            }
          }
        }
      }
    }
  }
  buildMesh(scene) {
    for (const type in this.meshes) {
      scene.remove(this.meshes[type]);
      this.meshes[type].geometry.dispose();
    }
    this.meshes = {};
    const CS = this.CS;
    const worldX = this.cx * CS;
    const worldZ = this.cz * CS;
    const faceData = {};
    for (let lx = 0; lx < CS; lx++) {
      for (let lz = 0; lz < CS; lz++) {
        for (let ly = 0; ly < this.MAX_Y; ly++) {
          const type = this.blocks[this.idx(lx, ly, lz)];
          if (type === BLOCK.AIR) continue;
          const wx = worldX + lx;
          const wz = worldZ + lz;
          if (this.isTransparent(this.world.getBlock(wx+1, ly, wz), type)) this.addFace(faceData, type, lx, ly, lz, 'px');
          if (this.isTransparent(this.world.getBlock(wx-1, ly, wz), type)) this.addFace(faceData, type, lx, ly, lz, 'nx');
          if (this.isTransparent(this.world.getBlock(wx, ly+1, wz), type)) this.addFace(faceData, type, lx, ly, lz, 'py');
          if (this.isTransparent(this.world.getBlock(wx, ly-1, wz), type)) this.addFace(faceData, type, lx, ly, lz, 'ny');
          if (this.isTransparent(this.world.getBlock(wx, ly, wz+1), type)) this.addFace(faceData, type, lx, ly, lz, 'pz');
          if (this.isTransparent(this.world.getBlock(wx, ly, wz-1), type)) this.addFace(faceData, type, lx, ly, lz, 'nz');
        }
      }
    }
    for (const type in faceData) {
      const data = faceData[type];
      if (data.positions.length === 0) continue;
      const geometry = new THREE.BufferGeometry();
      geometry.setAttribute('position', new THREE.Float32BufferAttribute(data.positions, 3));
      geometry.setAttribute('normal', new THREE.Float32BufferAttribute(data.normals, 3));
      geometry.setAttribute('uv', new THREE.Float32BufferAttribute(data.uvs, 2));
      geometry.setIndex(data.indices);
      const material = this.createMaterial(parseInt(type));
      const mesh = new THREE.Mesh(geometry, material);
      mesh.position.set(worldX, 0, worldZ);
      scene.add(mesh);
      this.meshes[type] = mesh;
    }
    this.dirty = false;
  }
  isTransparent(neighborType, selfType) {
    if (neighborType === BLOCK.AIR) return true;
    if (neighborType === BLOCK.WATER && selfType !== BLOCK.WATER) return true;
    if (neighborType === BLOCK.LEAVES && selfType !== BLOCK.LEAVES) return true;
    return false;
  }
  addFace(faceData, type, lx, ly, lz, face) {
    if (!faceData[type]) faceData[type] = { positions: [], normals: [], uvs: [], indices: [] };
    const data = faceData[type];
    const baseIndex = data.positions.length / 3;
    let verts, normal;
    switch (face) {
      case 'px': verts = [lx+1,ly,lz, lx+1,ly+1,lz, lx+1,ly+1,lz+1, lx+1,ly,lz+1]; normal = [1,0,0]; break;
      case 'nx': verts = [lx,ly,lz+1, lx,ly+1,lz+1, lx,ly+1,lz, lx,ly,lz]; normal = [-1,0,0]; break;
      case 'py': verts = [lx,ly+1,lz, lx,ly+1,lz+1, lx+1,ly+1,lz+1, lx+1,ly+1,lz]; normal = [0,1,0]; break;
      case 'ny': verts = [lx,ly,lz+1, lx,ly,lz, lx+1,ly,lz, lx+1,ly,lz+1]; normal = [0,-1,0]; break;
      case 'pz': verts = [lx+1,ly,lz+1, lx+1,ly+1,lz+1, lx,ly+1,lz+1, lx,ly,lz+1]; normal = [0,0,1]; break;
      case 'nz': verts = [lx,ly,lz, lx,ly+1,lz, lx+1,ly+1,lz, lx+1,ly,lz]; normal = [0,0,-1]; break;
    }
    data.positions.push(...verts);
    for (let i = 0; i < 4; i++) data.normals.push(...normal);
    data.uvs.push(0,0, 0,1, 1,1, 1,0);
    data.indices.push(baseIndex, baseIndex+1, baseIndex+2, baseIndex, baseIndex+2, baseIndex+3);
  }
  createMaterial(type) {
    const isWater = (type === BLOCK.WATER);
    const isLeaves = (type === BLOCK.LEAVES);
    const tex = TextureGenerator.getTexture(type, 'side');
    return new THREE.MeshLambertMaterial({
      map: tex,
      transparent: isWater || isLeaves,
      opacity: isWater ? 0.6 : (isLeaves ? 0.9 : 1.0),
      side: THREE.FrontSide,
    });
  }
  dispose(scene) {
    for (const type in this.meshes) {
      scene.remove(this.meshes[type]);
      this.meshes[type].geometry.dispose();
    }
    this.meshes = {};
  }
}


// ================================================================
//  CLASE WORLD
// ================================================================
class World {
  constructor(scene) {
    this.scene = scene;
    this.chunks = new Map();
    this.CS = CFG.CHUNK_SIZE;
  }
  chunkKey(cx, cz) { return `${cx},${cz}`; }
  getChunkCoords(wx, wz) {
    return { cx: Math.floor(wx / this.CS), cz: Math.floor(wz / this.CS) };
  }
  getLocalCoords(wx, wz) {
    const cx = Math.floor(wx / this.CS);
    const cz = Math.floor(wz / this.CS);
    let lx = Math.floor(wx) % this.CS;
    let lz = Math.floor(wz) % this.CS;
    if (lx < 0) lx += this.CS;
    if (lz < 0) lz += this.CS;
    return { lx, lz, cx, cz };
  }
  getBlock(wx, wy, wz) {
    if (wy < 0 || wy >= CFG.MAX_Y) return BLOCK.AIR;
    const { cx, cz, lx, lz } = this.getLocalCoords(wx, wz);
    const chunk = this.chunks.get(this.chunkKey(cx, cz));
    if (!chunk) return BLOCK.AIR;
    return chunk.getBlock(lx, wy, lz);
  }
  setBlock(wx, wy, wz, type) {
    if (wy < 0 || wy >= CFG.MAX_Y) return;
    const { cx, cz, lx, lz } = this.getLocalCoords(wx, wz);
    const chunk = this.chunks.get(this.chunkKey(cx, cz));
    if (!chunk) return;
    chunk.setBlock(lx, wy, lz, type);
    if (lx === 0) this.markDirty(cx - 1, cz);
    if (lx === this.CS - 1) this.markDirty(cx + 1, cz);
    if (lz === 0) this.markDirty(cx, cz - 1);
    if (lz === this.CS - 1) this.markDirty(cx, cz + 1);
  }
  markDirty(cx, cz) {
    const chunk = this.chunks.get(this.chunkKey(cx, cz));
    if (chunk) chunk.dirty = true;
  }
  loadChunk(cx, cz) {
    const key = this.chunkKey(cx, cz);
    if (this.chunks.has(key)) return this.chunks.get(key);
    const chunk = new Chunk(cx, cz, this);
    chunk.generate();
    chunk.buildMesh(this.scene);
    this.chunks.set(key, chunk);
    return chunk;
  }
  unloadChunk(cx, cz) {
    const key = this.chunkKey(cx, cz);
    const chunk = this.chunks.get(key);
    if (chunk) { chunk.dispose(this.scene); this.chunks.delete(key); }
  }
  update(playerX, playerZ) {
    const { cx: pcx, cz: pcz } = this.getChunkCoords(playerX, playerZ);
    const renderDist = CFG.RENDER_DIST;
    for (let dx = -renderDist; dx <= renderDist; dx++) {
      for (let dz = -renderDist; dz <= renderDist; dz++) {
        const cx = pcx + dx;
        const cz = pcz + dz;
        if (!this.chunks.has(this.chunkKey(cx, cz))) this.loadChunk(cx, cz);
      }
    }
    const toUnload = [];
    for (const [key, chunk] of this.chunks) {
      const dx = chunk.cx - pcx;
      const dz = chunk.cz - pcz;
      if (Math.abs(dx) > renderDist || Math.abs(dz) > renderDist) toUnload.push(key);
    }
    for (const key of toUnload) {
      const chunk = this.chunks.get(key);
      this.unloadChunk(chunk.cx, chunk.cz);
    }
    for (const chunk of this.chunks.values()) {
      if (chunk.dirty) chunk.buildMesh(this.scene);
    }
  }
  getGroundY(wx, wz) {
    for (let y = CFG.MAX_Y - 1; y >= 0; y--) {
      const block = this.getBlock(Math.floor(wx), y, Math.floor(wz));
      if (block !== BLOCK.AIR && block !== BLOCK.WATER && block !== BLOCK.LEAVES) return y;
    }
    return CFG.SEA_LEVEL;
  }
  getBiomeAt(wx, wz) {
    return BIOME_PARAMS[getBiome(Math.floor(wx), Math.floor(wz))].name;
  }
}


// ================================================================
//  SISTEMA DE INVENTARIO
// ================================================================
class Inventory {
  constructor() {
    this.slots = new Array(CFG.INVENTORY_SIZE).fill(null);
    this.selectedSlot = 0;
  }
  addItem(type, count = 1) {
    for (let i = 0; i < this.slots.length; i++) {
      if (this.slots[i] && this.slots[i].type === type) {
        this.slots[i].count += count;
        return true;
      }
    }
    for (let i = 0; i < this.slots.length; i++) {
      if (!this.slots[i]) {
        this.slots[i] = { type, count };
        return true;
      }
    }
    return false;
  }
  removeItem(slotIndex, count = 1) {
    if (slotIndex < 0 || slotIndex >= this.slots.length) return false;
    if (!this.slots[slotIndex]) return false;
    this.slots[slotIndex].count -= count;
    if (this.slots[slotIndex].count <= 0) this.slots[slotIndex] = null;
    return true;
  }
  getSelectedItem() { return this.slots[this.selectedSlot]; }
  selectSlot(index) {
    if (index >= 0 && index < CFG.HOTBAR_SIZE) this.selectedSlot = index;
  }
  moveItem(fromIndex, toIndex) {
    if (fromIndex < 0 || fromIndex >= this.slots.length) return;
    if (toIndex < 0 || toIndex >= this.slots.length) return;
    const temp = this.slots[fromIndex];
    this.slots[fromIndex] = this.slots[toIndex];
    this.slots[toIndex] = temp;
  }
}
