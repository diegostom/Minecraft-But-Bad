  MOUSE_SENS   : 0.002,
  FOG_NEAR     : 50,
  FOG_FAR      : 100,
  FOV          : 75,
  REACH_DISTANCE: 5.0,
  MINING_TIME  : 0.5,
  INVENTORY_SIZE: 36,
  HOTBAR_SIZE: 9,
  STEP_INTERVAL: 0.45,
};

const BLOCK = { 
  AIR: 0, GRASS: 1, DIRT: 2, STONE: 3, SAND: 4, 
  WATER: 5, BEDROCK: 6, WOOD: 7, LEAVES: 8, PLANKS: 9,
};

const BLOCK_NAMES = {
  [BLOCK.AIR]: 'Aire', [BLOCK.GRASS]: 'Hierba', [BLOCK.DIRT]: 'Tierra',
  [BLOCK.STONE]: 'Piedra', [BLOCK.SAND]: 'Arena', [BLOCK.WATER]: 'Agua',
  [BLOCK.BEDROCK]: 'Bedrock', [BLOCK.WOOD]: 'Madera',
  [BLOCK.LEAVES]: 'Hojas', [BLOCK.PLANKS]: 'Tablas',
};

const BLOCK_COLORS = {
  [BLOCK.GRASS]:0x5B8C32, [BLOCK.DIRT]:0x8B6914, [BLOCK.STONE]:0x7A7A7A,
  [BLOCK.SAND]:0xC2B280, [BLOCK.WATER]:0x3377CC, [BLOCK.BEDROCK]:0x333333,
  [BLOCK.WOOD]:0x8B6914, [BLOCK.LEAVES]:0x2D5016, [BLOCK.PLANKS]:0xC4A882,
};

const BIOME = { OCEAN:0, BEACH:1, PLAINS:2, HILLS:3, MOUNTAINS:4, ROCK:5 };

const BIOME_PARAMS = {
  [BIOME.OCEAN]:    { minH:2,  maxH:10, scale:1.0, name:'Océano',    trees:false },
  [BIOME.BEACH]:    { minH:16, maxH:20, scale:0.5, name:'Playa',     trees:false },
  [BIOME.PLAINS]:   { minH:18, maxH:24, scale:0.8, name:'Llanura',   trees:true  },
  [BIOME.HILLS]:    { minH:20, maxH:32, scale:1.2, name:'Colinas',   trees:true  },
  [BIOME.MOUNTAINS]:{ minH:28, maxH:55, scale:1.8, name:'Montañas',  trees:false },
  [BIOME.ROCK]:     { minH:22, maxH:35, scale:1.5, name:'Roca',      trees:false },
};


// ================================================================
//  SISTEMA DE AUDIO (WebAudioAPI)
// ================================================================
class AudioManager {
  constructor() {
    this.ctx = null;
    this.masterGain = null;
    this.sfxGain = null;
    this.stepsGain = null;
    this.initialized = false;
    this.settings = { master: 0.7, sfx: 0.8, steps: 0.5 };
  }
  init() {
    if (this.initialized) return;
    try {
      this.ctx = new (window.AudioContext || window.webkitAudioContext)();
      this.masterGain = this.ctx.createGain();
      this.masterGain.gain.value = this.settings.master;
      this.masterGain.connect(this.ctx.destination);
      this.sfxGain = this.ctx.createGain();
      this.sfxGain.gain.value = this.settings.sfx;
      this.sfxGain.connect(this.masterGain);
      this.stepsGain = this.ctx.createGain();
      this.stepsGain.gain.value = this.settings.steps;
      this.stepsGain.connect(this.masterGain);
      this.initialized = true;
    } catch (e) { console.warn('WebAudioAPI no disponible:', e); }
  }
  resume() {
    if (this.ctx && this.ctx.state === 'suspended') this.ctx.resume();
  }
  updateSettings(s) {
    this.settings = { ...s };
    if (this.masterGain) this.masterGain.gain.value = s.master;
    if (this.sfxGain) this.sfxGain.gain.value = s.sfx;
    if (this.stepsGain) this.stepsGain.gain.value = s.steps;
  }
  _noise(duration) {
    const bufferSize = this.ctx.sampleRate * duration;
    const buffer = this.ctx.createBuffer(1, bufferSize, this.ctx.sampleRate);
    const data = buffer.getChannelData(0);
    for (let i = 0; i < bufferSize; i++) data[i] = Math.random() * 2 - 1;
    return buffer;
  }
  playHit() {
    if (!this.initialized) return;
    this.resume();
    const t = this.ctx.currentTime;
    const buffer = this._noise(0.08);
    const src = this.ctx.createBufferSource();
    src.buffer = buffer;
    const filter = this.ctx.createBiquadFilter();
    filter.type = 'bandpass';
    filter.frequency.value = 800 + Math.random() * 400;
    filter.Q.value = 2;
    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0.4, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.08);
    src.connect(filter); filter.connect(gain); gain.connect(this.sfxGain);
    src.start(t); src.stop(t + 0.08);
  }
  playBreak() {
    if (!this.initialized) return;
    this.resume();
    const t = this.ctx.currentTime;
    const buffer = this._noise(0.15);
    const src = this.ctx.createBufferSource();
    src.buffer = buffer;
    const filter = this.ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 600;
    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0.5, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.15);
    src.connect(filter); filter.connect(gain); gain.connect(this.sfxGain);
    src.start(t); src.stop(t + 0.15);
  }
  playPlace() {
    if (!this.initialized) return;
    this.resume();
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    osc.type = 'square';
    osc.frequency.setValueAtTime(180, t);
    osc.frequency.exponentialRampToValueAtTime(80, t + 0.1);
    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0.3, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.1);
    osc.connect(gain); gain.connect(this.sfxGain);
    osc.start(t); osc.stop(t + 0.1);
  }
  playStep() {
    if (!this.initialized) return;
    this.resume();
    const t = this.ctx.currentTime;
    const buffer = this._noise(0.06);
    const src = this.ctx.createBufferSource();
    src.buffer = buffer;
    const filter = this.ctx.createBiquadFilter();
    filter.type = 'lowpass';
    filter.frequency.value = 400 + Math.random() * 200;
    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0.25, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.06);
    src.connect(filter); filter.connect(gain); gain.connect(this.stepsGain);
    src.start(t); src.stop(t + 0.06);
  }
  playJump() {
    if (!this.initialized) return;
    this.resume();
    const t = this.ctx.currentTime;
    const osc = this.ctx.createOscillator();
    osc.type = 'sine';
    osc.frequency.setValueAtTime(200, t);
    osc.frequency.exponentialRampToValueAtTime(400, t + 0.12);
    const gain = this.ctx.createGain();
    gain.gain.setValueAtTime(0.2, t);
    gain.gain.exponentialRampToValueAtTime(0.01, t + 0.12);
    osc.connect(gain); gain.connect(this.sfxGain);
    osc.start(t); osc.stop(t + 0.12);
  }
  playCraft() {
    if (!this.initialized) return;
    this.resume();
    const t = this.ctx.currentTime;
    [0, 0.08].forEach((delay, i) => {
      const osc = this.ctx.createOscillator();
      osc.type = 'triangle';
      osc.frequency.value = 400 + i * 200;
      const gain = this.ctx.createGain();
      gain.gain.setValueAtTime(0, t + delay);
      gain.gain.linearRampToValueAtTime(0.3, t + delay + 0.02);
      gain.gain.exponentialRampToValueAtTime(0.01, t + delay + 0.1);
      osc.connect(gain); gain.connect(this.sfxGain);
      osc.start(t + delay); osc.stop(t + delay + 0.1);
    });
  }
}
const audio = new AudioManager();


// ================================================================
//  GENERADOR DE TEXTURAS PROCEDURALES
// ================================================================
class TextureGenerator {
  static TEX_SIZE = 16;
  static textures = {};
  static getTexture(type, face) {
    const key = `${type}-${face}`;
    if (this.textures[key]) return this.textures[key];
    const texture = this.createTexture(type, face);
    this.textures[key] = texture;
    return texture;
  }
  static createTexture(type, face) {
    const canvas = document.createElement('canvas');
    canvas.width = canvas.height = this.TEX_SIZE;
    const ctx = canvas.getContext('2d');
    switch (type) {
      case BLOCK.GRASS:
        if (face === 'top') this.drawGrassTop(ctx);
        else if (face === 'bottom') this.drawDirt(ctx);
        else this.drawGrassSide(ctx);
        break;
      case BLOCK.DIRT:    this.drawDirt(ctx); break;
      case BLOCK.STONE:   this.drawStone(ctx); break;
      case BLOCK.SAND:    this.drawSand(ctx); break;
      case BLOCK.WATER:   this.drawWater(ctx); break;
      case BLOCK.BEDROCK: this.drawBedrock(ctx); break;
      case BLOCK.WOOD:
        if (face === 'top' || face === 'bottom') this.drawWoodTop(ctx);
        else this.drawWoodSide(ctx);
        break;
      case BLOCK.LEAVES:  this.drawLeaves(ctx); break;
      case BLOCK.PLANKS:  this.drawPlanks(ctx); break;
    }
    const texture = new THREE.CanvasTexture(canvas);
    texture.magFilter = THREE.NearestFilter;
    texture.minFilter = THREE.NearestFilter;
    if (type === BLOCK.LEAVES) texture.transparent = true;
    return texture;
  }
  static noisePixel(ctx, x, y, baseColor, variance) {
    const r = baseColor[0] + (Math.random() - 0.5) * variance;
    const g = baseColor[1] + (Math.random() - 0.5) * variance;
    const b = baseColor[2] + (Math.random() - 0.5) * variance;
    ctx.fillStyle = `rgb(${Math.floor(r)},${Math.floor(g)},${Math.floor(b)})`;
    ctx.fillRect(x, y, 1, 1);
  }
  static drawGrassTop(ctx) {
    const base = [91, 140, 50];
    for (let y = 0; y < this.TEX_SIZE; y++)
      for (let x = 0; x < this.TEX_SIZE; x++)
        this.noisePixel(ctx, x, y, base, 30);
  }
  static drawGrassSide(ctx) {
