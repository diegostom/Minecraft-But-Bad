// ================================================================
//  DDA VOXEL TRAVERSAL
// ================================================================
function raycastVoxel(origin, direction, maxDistance) {
  let x = Math.floor(origin.x);
  let y = Math.floor(origin.y);
  let z = Math.floor(origin.z);
  const stepX = direction.x > 0 ? 1 : -1;
  const stepY = direction.y > 0 ? 1 : -1;
  const stepZ = direction.z > 0 ? 1 : -1;
  const tDeltaX = Math.abs(1 / (direction.x || 0.0001));
  const tDeltaY = Math.abs(1 / (direction.y || 0.0001));
  const tDeltaZ = Math.abs(1 / (direction.z || 0.0001));
  const xBound = (stepX > 0 ? (x + 1) : x) - origin.x;
  const yBound = (stepY > 0 ? (y + 1) : y) - origin.y;
  const zBound = (stepZ > 0 ? (z + 1) : z) - origin.z;
  let tMaxX = (direction.x !== 0) ? xBound / direction.x : Infinity;
  let tMaxY = (direction.y !== 0) ? yBound / direction.y : Infinity;
  let tMaxZ = (direction.z !== 0) ? zBound / direction.z : Infinity;
  let face = null;
  let distance = 0;
  while (distance < maxDistance) {
    const block = world.getBlock(x, y, z);
    if (block !== BLOCK.AIR && block !== BLOCK.WATER && block !== BLOCK.LEAVES) {
      return { x, y, z, face, distance, block };
    }
    if (tMaxX < tMaxY) {
      if (tMaxX < tMaxZ) {
        x += stepX; distance = tMaxX; tMaxX += tDeltaX;
        face = stepX > 0 ? 'west' : 'east';
      } else {
        z += stepZ; distance = tMaxZ; tMaxZ += tDeltaZ;
        face = stepZ > 0 ? 'north' : 'south';
      }
    } else {
      if (tMaxY < tMaxZ) {
        y += stepY; distance = tMaxY; tMaxY += tDeltaY;
        face = stepY > 0 ? 'bottom' : 'top';
      } else {
        z += stepZ; distance = tMaxZ; tMaxZ += tDeltaZ;
        face = stepZ > 0 ? 'north' : 'south';
      }
    }
  }
  return null;
}


